{
    "name": "memo-init-website",
    "version": "0.1.0",
    "description": "memo-init documentation website — Astro + Starlight, serves the spec docs and llms.txt",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "npm run sync-spec && npm run generate-markdown-map && astro dev",
        "start": "npm run sync-spec && npm run generate-markdown-map && astro dev",
        "sync-spec": "node scripts/sync-spec.mjs",
        "fetch-refs": "node scripts/fetch-refs.mjs",
        "favicons": "node scripts/generate-favicons.mjs",
        "generate-og": "node scripts/generate-og.mjs",
        "copy-llms": "node scripts/copy-llms.mjs",
        "generate-markdown-map": "node scripts/generate-markdown-map.mjs",
        "generate-robots-txt": "node scripts/generate-robots-txt.mjs",
        "inject-pagefind-meta": "node scripts/inject-pagefind-meta.mjs",
        "generate-build-stamp": "node scripts/generate-build-stamp.mjs",
        "check:mermaid": "node scripts/check-mermaid-renders.mjs",
        "check:published-llms": "node scripts/check-published-llms.mjs",
        "check:freshness": "node scripts/check-freshness.mjs",
        "test:pagefind": "node scripts/test-pagefind.mjs",
        "build": "npm run sync-spec && npm run fetch-refs && npm run generate-build-stamp && npm run copy-llms && npm run generate-markdown-map && npm run generate-robots-txt && npm run inject-pagefind-meta && astro build",
        "preview": "astro preview"
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.18",
        "@astrojs/starlight": "^0.38.2",
        "astro": "^6.4.6",
        "memo-init-spec": "github:Memo-Init/spec#f65d565a5195f1727b01ba2d795eda280f3946de",
        "rehype-mermaid": "^3.0.0",
        "sharp": "^0.34.2"
    },
    "devDependencies": {
        "playwright": "^1.60.0"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    }
}
