{
    "name": "memo-init-website",
    "version": "0.1.0",
    "description": "memo-init documentation website — Astro + Starlight, serves the spec docs and llms.txt",
    "type": "module",
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "sync-spec": "node scripts/sync-spec.mjs",
        "favicons": "node scripts/generate-favicons.mjs",
        "generate-llms-txt": "node scripts/generate-llms-txt.mjs",
        "generate-robots-txt": "node scripts/generate-robots-txt.mjs",
        "inject-pagefind-meta": "node scripts/inject-pagefind-meta.mjs",
        "test:pagefind": "node scripts/test-pagefind.mjs",
        "build": "npm run sync-spec && npm run generate-llms-txt && npm run generate-robots-txt && npm run inject-pagefind-meta && astro build",
        "preview": "astro preview"
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.18",
        "@astrojs/starlight": "^0.38.2",
        "astro": "^6.0.1",
        "rehype-mermaid": "^3.0.0",
        "sharp": "^0.34.2"
    }
}
